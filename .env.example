# Firebase Fleet Manager Configuration
PORT=4000
NODE_ENV=production

# Admin Bypass Key (Master Secret to bypass maintenance mode on any managed site)
FLEET_MASTER_BYPASS_KEY=fleet-admin-secret-2026

# Optional: Supabase Realtime Cloud Sync (Leave blank to use local state engine)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Firebase Realtime Database Sync (Leave blank to use local state engine)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
